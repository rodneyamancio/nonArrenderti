{
  "name": "tenace",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "node infra/scripts/setup-env.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@tenace/api --filter=@tenace/web",
    "lint": "turbo run typecheck",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose -f compose.yaml --env-file .env up -d postgres redis",
    "infra:down": "docker compose -f compose.yaml --env-file .env down",
    "db:migrate": "pnpm --filter @tenace/api prisma:migrate",
    "db:seed": "pnpm --filter @tenace/api seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "@nestjs/core", "esbuild"]
  }
}
