# Tenace — local development. `pnpm setup` copies this to .env with random secrets.
NODE_ENV=development
APP_TIMEZONE=America/Sao_Paulo
POSTGRES_USER=tenace
POSTGRES_PASSWORD=__generated__
POSTGRES_DB=tenace
POSTGRES_PORT=55462
REDIS_PORT=56399
DATABASE_URL=postgresql://tenace:__generated__@localhost:55462/tenace?schema=public
REDIS_URL=redis://localhost:56399
APP_WEB_URL=http://localhost:3310
API_INTERNAL_URL=http://localhost:3311
PORT=3311
UPLOAD_DIR=./uploads
# Optional: smtp://user:pass@host:587 — without it, e-mails are only logged.
SMTP_URL=
MAIL_FROM="Tenace <nao-responda@tenace.local>"
SEED_ADMIN_EMAIL=admin@tenace.local
SEED_ADMIN_PASSWORD=__generated__
SEED_DEMO_DATA=true
