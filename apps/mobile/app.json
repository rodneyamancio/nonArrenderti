{
  "expo": {
    "name": "Tenace",
    "slug": "tenace",
    "owner": "valiant-group-do-brasil",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tenace",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "family.amancio.tenace",
      "infoPlist": {
        "NSCameraUsageDescription": "O Tenace usa a câmera para ler o QR Code de login do portal e para a foto do registro ou do comprovante que você escolher enviar.",
        "NSPhotoLibraryUsageDescription": "O Tenace abre suas fotos só para você escolher a imagem do registro ou do comprovante.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "family.amancio.tenace",
      "adaptiveIcon": {
        "backgroundColor": "#6D3BFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4FB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0E0C15",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Tenace abre suas fotos só para você escolher a imagem do registro ou do comprovante.",
          "cameraPermission": "O Tenace usa a câmera só para tirar a foto do registro ou do comprovante que você escolher enviar.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Tenace usa a câmera para ler o QR Code de login do portal e para a foto do registro ou do comprovante que você escolher enviar.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e78a3a9e-ab45-4d70-a0c7-44580431bb49"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e78a3a9e-ab45-4d70-a0c7-44580431bb49",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
